{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nodenext makes the compiler insist on explicit ".js" import paths, which
    // is what Node requires at runtime for ES modules.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
