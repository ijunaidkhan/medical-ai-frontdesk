# Copy this file to `.env` (which git ignores) and adjust for your machine.
# Never put real secrets in this file: it is committed to the repository.
# Real environment variables always take precedence over values in `.env`.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (Docker Compose) -------------------------------------------------
# Choose your own strong passwords for local development. These are placeholders
# that are intentionally invalid: Docker Compose will refuse to start until you
# replace them in your own `.env`.
POSTGRES_DB=frontdesk
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Connection strings. Replace the passwords with the values chosen above.
# The API connects as frontdesk_app (subject to tenant isolation). The owner URL
# is used ONLY by migrations and tests, never by the running API.
DATABASE_URL=postgres://frontdesk_app:REPLACE_WITH_DB_APP_PASSWORD@localhost:5432/frontdesk
MIGRATION_DATABASE_URL=postgres://frontdesk_owner:REPLACE_WITH_DB_OWNER_PASSWORD@localhost:5432/frontdesk

# --- API -----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (must include http:// or https://).
# Leave empty to disallow all cross-origin access.
CORS_ORIGINS=http://localhost:4200
