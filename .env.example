# Copy this file to `.env` (which git ignores) and adjust for your machine.
# Never put real secrets in this file: it is committed to the repository.
# Real environment variables always take precedence over values in `.env`.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (Docker Compose) -------------------------------------------------
# Choose your own strong passwords for local development. These are placeholders
# that are intentionally invalid: Docker Compose will refuse to start until you
# replace them in your own `.env`.
POSTGRES_DB=frontdesk
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Connection strings. Replace the passwords with the values chosen above.
# The API connects as frontdesk_app (subject to tenant isolation). The owner URL
# is used ONLY by migrations and tests, never by the running API.
DATABASE_URL=postgres://frontdesk_app:REPLACE_WITH_DB_APP_PASSWORD@localhost:5432/frontdesk
MIGRATION_DATABASE_URL=postgres://frontdesk_owner:REPLACE_WITH_DB_OWNER_PASSWORD@localhost:5432/frontdesk

# --- Authentication ------------------------------------------------------------
# Key that signs access tokens. Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out. Use a different value in every environment.
ACCESS_TOKEN_SECRET=

# Number of reverse proxies / load balancers in front of the API (0 = none, e.g. local dev).
# Set to 1 behind a single load balancer. Too high lets clients spoof their IP address.
TRUST_PROXY_HOPS=0

# --- AI receptionist: language model ---------------------------------------------
# none (default): no model. Test chats cannot start; the fixed emergency scripts still work.
# ollama: a free model running on YOUR OWN computer (no account, no key, nothing leaves the machine).
#         Install Ollama from ollama.com, then run:  ollama pull llama3.1:8b   (or llama3.2:3b, faster)
# anthropic: Claude through Anthropic's API (needs the key below).
LLM_PROVIDER=none
# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Where Ollama listens. From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# A model that supports tools: llama3.1:8b, llama3.2:3b, qwen2.5:7b, mistral-nemo ...
OLLAMA_MODEL=llama3.1:8b
# A model on a laptop is slow, especially the first reply (it has to load into memory).
OLLAMA_TIMEOUT_SECONDS=90
# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
# Your Anthropic API key (starts with "sk-ant-"). A SECRET: put it only in your own `.env`
# (which git ignores), never in this file, never in chat, never in screenshots.
# Only used when LLM_PROVIDER=anthropic. Patients' conversations are sent to Anthropic,
# so make sure your agreement with them covers this use before real patients call.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (more capable) or claude-haiku-4-5-20251001 (faster and cheaper).
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Phone calls -----------------------------------------------------------------
# none (default): the /api/voice routes do not exist.
# twilio: the API answers calls forwarded by Twilio (needs the two settings below).
VOICE_PROVIDER=none
# Your Twilio "Auth Token" (Twilio console, Account info). A SECRET: only in your own `.env`,
# never in this file, never in chat, never in screenshots. It is used only to check that a
# request really came from Twilio (its signature).
TWILIO_AUTH_TOKEN=
# The public https address Twilio uses to reach this API, with no trailing slash, for example
# the address of your tunnel: https://your-name.trycloudflare.com
# Twilio signs the exact address it called, so this must match what you enter in Twilio.
PUBLIC_BASE_URL=
# Optional: which speech engine talks to callers (Google | Amazon | ElevenLabs) and which one
# listens (Google | Deepgram) inside Twilio. Leave empty to use Twilio's defaults. Before real
# patients call, confirm that your agreements cover the engines you use.
VOICE_TTS_PROVIDER=
VOICE_STT_PROVIDER=

# --- API -----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (must include http:// or https://).
# Leave empty to disallow all cross-origin access.
CORS_ORIGINS=http://localhost:4200
